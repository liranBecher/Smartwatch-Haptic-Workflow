    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"UseCaseDictionary\" (usecase_name, usecase_parameter_name, parameter_format, is_required, description,api_pool_id,param_value) \nVALUES ($1, $2, $3, $4, $5,$6,$7) RETURNING *;",
        "options": {
          "queryReplacement": "={{ $('Action Router').item.json.params.usecase_name }},{{ $('Action Router').item.json.params.usecase_parameter_name }},{{ $('Action Router').item.json.params.parameter_format }},{{ $('Action Router').item.json.params.is_required }},{{ $('Action Router').item.json.params.description||null }},\n{{ $json.api_pool_id }},\n{{$('Action Router').item.json.params.param_value||null }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2352,
        1264
      ],
      "id": "93f4361a-d5ee-4b54-890a-81b835228db0",
      "name": "Add Entry",
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "SxQ8vRANzWTnEuGI",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst session_id = $('Execute Workflow Trigger').first().json.session_id;\n\nconst isEmpty = items.length === 0 || Object.keys(items[0].json).length === 0;\n\nif (isEmpty) {\n  return [{\n    json: {\n      reply: \"The use case dictionary is currently empty.\",\n      session_id\n    }\n  }];\n}\n\nconst rows = items.map(i => i.json);\n\nconst grouped = rows.reduce((acc, row) => {\n  if (!acc[row.usecase_name]) acc[row.usecase_name] = [];\n\n  // Check if param_value exists and is not null/empty\n  const valueStr = row.param_value !== null && row.param_value !== undefined && row.param_value !== '' \n    ? ` = ${row.param_value} [Specific value!]` \n    : '';\n\n  acc[row.usecase_name].push(\n    `    ${row.usecase_parameter_name} (${row.parameter_format}${valueStr})${row.is_required ? ' [Required]' : ''}`\n  );\n\n  return acc;\n}, {});\n\nconst lines = Object.keys(grouped)\n  .map(name => `📂 **${name}**\\n${grouped[name].join('\\n')}`)\n  .join('\\n\\n');\n\nreturn [{\n  json: {\n    reply: `Here are the available use cases and their parameters:\\n\\n${lines}`,\n    session_id\n  }\n}];"
      },
