      "id": "2367e07b-b577-4731-a66d-195b2d6c4071",
      "name": "Add Entry",
      "credentials": {
        "postgres": {
          "id": "PGGVkGCzTaoS4R2q",
          "name": "Postgres account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst session_id = $('Execute Workflow Trigger').first().json.session_id;\n\nconst isEmpty = items.length === 0 || Object.keys(items[0].json).length === 0;\n\nif (isEmpty) {\n  return [{\n    json: {\n      reply: \"The use case dictionary is currently empty.\",\n      session_id\n    }\n  }];\n}\n\nconst rows = items.map(i => i.json);\n\nconst grouped = rows.reduce((acc, row) => {\n  if (!acc[row.usecase_name]) acc[row.usecase_name] = [];\n\n  acc[row.usecase_name].push(\n    `   ${row.usecase_parameter_name} (${row.parameter_format})${row.is_required ? ' [Required]' : ''}`\n  );\n\n  return acc;\n}, {});\n\nconst lines = Object.keys(grouped)\n  .map(name => `📂 **${name}**\\n${grouped[name].join('\\n')}`)\n  .join('\\n\\n');\n\nreturn [{\n  json: {\n    reply: `Here are the available use cases and their parameters:\\n\\n${lines}`,\n    session_id\n  }\n}];"
      },
      "id": "9e4033bd-7088-423e-9c8b-c121ca19f3a1",
