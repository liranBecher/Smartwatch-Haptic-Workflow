    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst session_id = $('Execute Workflow Trigger').first().json.session_id;\n\nconst isEmpty = items.length === 0 || Object.keys(items[0].json).length === 0;\n\nif (isEmpty) {\n  return [{\n    json: {\n      reply: \"I couldn't find any parameters for that specific use case.\",\n      session_id\n    }\n  }];\n}\n\n// Extract rows\nconst rows = items.map(i => i.json);\n\n// Since they all belong to the same use case, grab the name from the first row\nconst usecaseName = rows[0].usecase_name;\n\n// Format each parameter line\nconst parameterLines = rows.map(row => {\n  // Check if param_value exists and is not null/empty\n  const valueStr = row.param_value !== null && row.param_value !== undefined && row.param_value !== '' \n    ? ` = ${row.param_value} [Specific value!]` \n    : '';\n\n  return `    🔹 ${row.usecase_parameter_name} (${row.parameter_format}${valueStr})${row.is_required ? ' [Required]' : ''}`;\n});\n\n// Build the clean, single-usecase reply\nconst replyText = `Here are the parameters for the **${usecaseName}** use case:\\n\\n${parameterLines.join('\\n')}`;\n\nreturn [{\n  json: {\n    reply: replyText,\n    session_id\n  }\n}];"
      },
