    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE \"UseCaseDictionary\"\nSET \n  usecase_name = CASE WHEN $2 = '' THEN usecase_name ELSE COALESCE($2, usecase_name) END,\n  usecase_parameter_name = CASE WHEN $3 = '' THEN usecase_parameter_name ELSE COALESCE($3, usecase_parameter_name) END,\n  parameter_format = CASE WHEN $4 = '' THEN parameter_format ELSE COALESCE($4, parameter_format) END,\n  is_required = COALESCE($5, is_required),\n  description = CASE WHEN $6 = '' THEN description ELSE COALESCE($6, description) END,\n  param_value = CASE WHEN $7 = '' THEN param_value ELSE COALESCE($7, param_value) END\nWHERE dict_entry = $1 \nRETURNING *;",
        "options": {
          "queryReplacement": "={{[\n$json.dict_entry,\n$('Execute Workflow Trigger').item.json.params?.usecase_name ?? null,\n$('Execute Workflow Trigger').item.json.params?.usecase_parameter_name ?? null, $('Execute Workflow Trigger').item.json.params?.parameter_format ?? null,\n$('Execute Workflow Trigger').item.json.params?.is_required ?? null,\n$('Execute Workflow Trigger').item.json.params?.Description ?? null,\n$('Execute Workflow Trigger').item.json.params?.param_value ?? null ] }}"
        }
